# 后端启动时需要由后端读取的环境变量（本文件不入库，复制为 local.env 后填写）
#
# 用法：
#   cp scripts/local.env.example scripts/local.env
#   # 编辑 scripts/local.env，填入真实密码
#   ./scripts/start-backend.sh
#
# 注意：local.env 已被 .gitignore 排除，切勿提交真实密码。

# 数据库密码（必填）
FDE_DB_PASSWORD=

# 数据库连接（可选，留空则使用默认值 192.168.2.125:3306/fde_workbench）
# FDE_DB_URL="jdbc:mysql://192.168.2.125:3306/fde_workbench?sessionVariables=time_zone='%2B08:00'&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true"
# FDE_DB_USERNAME=root

# 服务端口（可选，默认 8081）
# FDE_SERVER_PORT=8081

# 一键启动会生成本次专用的内部令牌，可显式设置同一令牌供独立重启的 Java 和 Host 复用。
# FDE_INTERNAL_TOKEN=

# Java 与 Host 共享的存储根。相对路径从仓库根解析，默认 data。
# FDE_STORAGE_ROOT=./data

# DSH Web 端口（默认 3080）。一键启动会按实际 DSH Web 地址配置后端 CORS。
# FDE_DSH_PORT=3080
